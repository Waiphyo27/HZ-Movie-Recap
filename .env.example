PORT=4000

# Directories
UPLOAD_DIR=./uploads
DOWNLOAD_DIR=./downloads

# Max upload size in MB
MAX_UPLOAD_MB=500

# yt-dlp binary path (leave as "yt-dlp" if installed globally / in PATH)
YT_DLP_PATH=yt-dlp

# Optional: cookies file for sites that require login (e.g. some Douyin/RedNote content)
# YT_DLP_COOKIES=./cookies.txt

# Audio/transcript output folders
AUDIO_DIR=./audio
TRANSCRIPT_DIR=./transcripts

# Groq API key — required for transcription (Step 3). FREE, no credit card.
# Get one at https://console.groq.com/keys (just needs email sign-up)
GROQ_API_KEY=gsk_your-key-here
